{
  "pluginAlias": "NukiMqttEvents",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "**Nuki for Apple Home — set up in 3 steps**\n\n1. Pick a ready-made setup below.\n2. In the **Nuki app**: Smart Lock → Settings → Features & Configuration → **MQTT** → turn it on, Host = this Homebridge server's IP, Port = 1883 (leave user/password empty).\n3. Paste a **Nuki Web token** if your setup uses the child lock or keypad codes, save, restart Homebridge, and add the lock in the Home app with the code shown in the log.",
  "schema": {
    "type": "object",
    "properties": {
      "preset": {
        "title": "Quick setup",
        "type": "string",
        "default": "full",
        "oneOf": [
          {
            "title": "⭐ Everything — lock in Apple Home, auto-lock after closing, child lock, keypad codes from Home, keypad battery, fingerprint switch",
            "enum": [
              "full"
            ]
          },
          {
            "title": "🔒 Lock only — lock in Apple Home with auto-lock after closing, child lock and keypad codes",
            "enum": [
              "lock"
            ]
          },
          {
            "title": "👆 Fingerprint switch only — a switch that turns on when someone opens with a fingerprint (e.g. to disarm an alarm)",
            "enum": [
              "fingerprint"
            ]
          },
          {
            "title": "⚙️ Custom — choose every feature yourself",
            "enum": [
              "custom"
            ]
          }
        ],
        "description": "One click: every feature of the template is turned on with good defaults. Choose Custom to pick features one by one."
      },
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Nuki MQTT Events"
      },
      "brokerMode": {
        "title": "MQTT broker",
        "type": "string",
        "default": "embedded",
        "oneOf": [
          {
            "title": "Built-in broker (standalone, recommended)",
            "enum": [
              "embedded"
            ]
          },
          {
            "title": "External broker (e.g. Mosquitto in Home Assistant)",
            "enum": [
              "external"
            ]
          }
        ]
      },
      "brokerPort": {
        "title": "Built-in broker port",
        "type": "integer",
        "default": 1883,
        "condition": {
          "functionBody": "return model.brokerMode !== 'external';"
        }
      },
      "host": {
        "title": "External broker host",
        "type": "string",
        "placeholder": "10.167.175.232",
        "condition": {
          "functionBody": "return model.brokerMode === 'external';"
        }
      },
      "port": {
        "title": "External broker port",
        "type": "integer",
        "default": 1883,
        "condition": {
          "functionBody": "return model.brokerMode === 'external';"
        }
      },
      "username": {
        "title": "MQTT username",
        "type": "string",
        "description": "Built-in broker: the login the Nuki lock (and Home Assistant, if used) must enter. Leave empty for no login."
      },
      "password": {
        "title": "MQTT password",
        "type": "string"
      },
      "deviceId": {
        "title": "Nuki ID (optional)",
        "type": "string",
        "placeholder": "4E2CC127",
        "description": "Found automatically. Only needed if you have more than one Nuki — it is the ID shown in the Nuki app (e.g. 4E2CC127)."
      },
      "topicPrefix": {
        "title": "Topic prefix",
        "type": "string",
        "default": "nuki"
      },
      "resetMs": {
        "title": "Switch on-time (ms)",
        "type": "integer",
        "default": 1000,
        "minimum": 200
      },
      "logEvents": {
        "title": "Log every lock event",
        "type": "boolean",
        "default": true
      },
      "switches": {
        "title": "Fingerprint / code switches",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Switch name",
              "type": "string",
              "required": true,
              "default": "Nuki Fingerprint"
            },
            "sources": {
              "title": "Triggered by",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "fingerprint",
                  "code"
                ]
              },
              "default": [
                "fingerprint"
              ]
            },
            "actions": {
              "title": "Lock actions",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "unlock",
                  "unlatch",
                  "locknGoUnlatch",
                  "lock",
                  "locknGo"
                ]
              },
              "default": [
                "unlock",
                "unlatch",
                "locknGoUnlatch"
              ]
            },
            "codeIds": {
              "title": "Only these Code IDs (optional, per person)",
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Leave empty for everyone. Code IDs appear in the Homebridge log."
            }
          }
        },
        "description": "Each switch turns on for a moment when the lock is opened this way. Use it in a Home automation (e.g. disarm the alarm)."
      },
      "keypad": {
        "title": "Keypad accessory",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Show the keypad as its own accessory",
            "type": "boolean",
            "default": false,
            "description": "A button with a battery: single press = fingerprint, double press = code. The Nuki only reports whether the keypad battery is low (no percentage), so Home shows 100% or 10% and a low-battery warning."
          },
          "name": {
            "title": "Keypad name in Apple Home",
            "type": "string",
            "default": "Nuki Keypad"
          }
        }
      },
      "childLock": {
        "title": "Child lock + Nuki Web (button on the lock, keypad codes)",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Show a child-lock switch",
            "type": "boolean",
            "default": false,
            "description": "Turns the physical button on the Smart Lock off and on through the Nuki Web API (cloud). Needs Nuki Web enabled for the lock, its PIN entered in web.nuki.io, and an API token."
          },
          "style": {
            "title": "Show as",
            "type": "string",
            "default": "matter",
            "oneOf": [
              {
                "title": "Child Lock row inside Front Door (recommended — no extra accessory)",
                "enum": [
                  "matter"
                ]
              },
              {
                "title": "A separate switch",
                "enum": [
                  "switch"
                ]
              },
              {
                "title": "Inside a separate HomeKit lock (old, not recommended)",
                "enum": [
                  "lock"
                ]
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string",
            "default": "Child Lock",
            "condition": {
              "functionBody": "return true;"
            },
            "description": "Name of the child-lock switch / section."
          },
          "lockName": {
            "title": "Lock name",
            "type": "string",
            "default": "Nuki",
            "condition": {
              "functionBody": "return model.childLock && model.childLock.style === 'lock';"
            },
            "description": "An extra HomeKit lock for the same door (Matter has no child-lock setting, so it cannot be added to the Matter lock)."
          },
          "token": {
            "title": "Nuki Web API token",
            "type": "string",
            "description": "Needed for the child lock and for keypad codes from Home. web.nuki.io → API → Generate API token, and tick only: View devices, View and edit devices, Manage device configuration, View and manage authorizations. Also enter the lock's PIN once in web.nuki.io."
          },
          "smartlockId": {
            "title": "Smart Lock ID (optional)",
            "type": "string",
            "description": "Found automatically from the Nuki device ID."
          },
          "pollMinutes": {
            "title": "Check Nuki Web every (minutes)",
            "type": "integer",
            "default": 10,
            "minimum": 2
          }
        }
      },
      "doorLock": {
        "title": "Matter door lock with door position (for iOS 27.2 \"Lock After Closing\")",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Enable the Matter door lock",
            "type": "boolean",
            "default": false,
            "description": "Runs a standalone Matter lock (own pairing code) that reports the door position. Lock/unlock commands go to the Nuki over MQTT — enable lock actions in the Nuki app's MQTT settings."
          },
          "name": {
            "title": "Lock name in Apple Home",
            "type": "string",
            "default": "Front Door"
          },
          "doorSwitchName": {
            "title": "Door sensor switch name",
            "type": "string",
            "default": "Door Open",
            "description": "A switch the plugin creates so any door sensor (Aqara, Eve…) can tell the lock if the door is open. In the Home app make two automations: door sensor opens → turn this switch on; door sensor closes → turn it off."
          },
          "lockAfterCloseSeconds": {
            "title": "Lock after closing (seconds, plugin fallback)",
            "type": "integer",
            "minimum": 0,
            "description": "Optional. Lock this many seconds after the door closes while unlocked. Leave empty to rely only on the setting in the Home app (Matter auto-relock time)."
          },
          "matterPort": {
            "title": "Matter port",
            "type": "integer",
            "default": 5560
          },
          "passcode": {
            "title": "Matter setup passcode",
            "type": "integer",
            "default": 20262027,
            "description": "8 digits. Changing it after pairing has no effect."
          },
          "discriminator": {
            "title": "Matter discriminator",
            "type": "integer",
            "default": 3127,
            "minimum": 0,
            "maximum": 4095
          },
          "actionTimeout": {
            "title": "Lock action timeout (s)",
            "type": "integer",
            "default": 30,
            "minimum": 5
          },
          "matterLogLevel": {
            "title": "Matter log level",
            "type": "string",
            "default": "warn",
            "enum": [
              "error",
              "warn",
              "notice",
              "info",
              "debug"
            ]
          },
          "accessCodes": {
            "title": "Access codes (Home \"Manage Access\" → Nuki Keypad)",
            "type": "boolean",
            "default": true,
            "description": "People and codes added in Home are created on the Nuki Keypad too (6 digits 1-9, not starting with 12). Needs the Nuki Web token from the Child lock section with the scope \"View and manage authorizations\". Changing this needs a re-pair in Home."
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "1 · Choose your setup",
      "items": [
        "preset"
      ]
    },
    {
      "type": "fieldset",
      "title": "2 · Nuki Web (child lock & keypad codes)",
      "condition": {
        "functionBody": "return ['full','lock'].includes(model.preset || 'full') || (model.preset === 'custom' && ((model.childLock && model.childLock.enabled) || (model.doorLock && model.doorLock.enabled)));"
      },
      "items": [
        "childLock.token"
      ]
    },
    {
      "type": "fieldset",
      "title": "3 · Names in Apple Home",
      "items": [
        {
          "key": "doorLock.name",
          "condition": {
            "functionBody": "return ['full','lock'].includes(model.preset || 'full') || (model.preset === 'custom' && model.doorLock && model.doorLock.enabled);"
          }
        },
        {
          "key": "doorLock.doorSwitchName",
          "condition": {
            "functionBody": "return ['full','lock'].includes(model.preset || 'full') || (model.preset === 'custom' && model.doorLock && model.doorLock.enabled);"
          }
        },
        {
          "key": "keypad.name",
          "condition": {
            "functionBody": "return (model.preset || 'full') === 'full' || (model.preset === 'custom' && model.keypad && model.keypad.enabled);"
          }
        },
        {
          "key": "childLock.name",
          "condition": {
            "functionBody": "return ['full','lock'].includes(model.preset || 'full') || (model.preset === 'custom' && model.doorLock && model.doorLock.enabled);"
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Features (Custom)",
      "condition": {
        "functionBody": "return model.preset === 'custom';"
      },
      "items": [
        "doorLock.enabled",
        "doorLock.accessCodes",
        "childLock.enabled",
        "childLock.style",
        "keypad.enabled"
      ]
    },
    {
      "type": "fieldset",
      "title": "Fingerprint / code switches",
      "expandable": true,
      "expanded": false,
      "condition": {
        "functionBody": "return ['full','fingerprint'].includes(model.preset || 'full') || model.preset === 'custom';"
      },
      "items": [
        "switches"
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": [
        "deviceId",
        "name",
        "brokerMode",
        "brokerPort",
        "host",
        "port",
        "username",
        "password",
        "topicPrefix",
        "resetMs",
        "logEvents",
        "doorLock.lockAfterCloseSeconds",
        "doorLock.actionTimeout",
        "doorLock.matterPort",
        "doorLock.passcode",
        "doorLock.discriminator",
        "doorLock.matterLogLevel",
        "childLock.lockName",
        "childLock.smartlockId",
        "childLock.pollMinutes"
      ]
    }
  ]
}
