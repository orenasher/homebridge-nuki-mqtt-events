{
  "pluginAlias": "NukiMqttEvents",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Momentary switches that turn on for a moment when the Nuki lock is opened by fingerprint or keypad code. Uses a built-in MQTT broker by default — no Home Assistant or Mosquitto needed. Point the Nuki app's MQTT host to this Homebridge server's IP.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Nuki MQTT Events"
      },
      "brokerMode": {
        "title": "MQTT broker",
        "type": "string",
        "default": "embedded",
        "oneOf": [
          {
            "title": "Built-in broker (standalone, recommended)",
            "enum": [
              "embedded"
            ]
          },
          {
            "title": "External broker (e.g. Mosquitto in Home Assistant)",
            "enum": [
              "external"
            ]
          }
        ]
      },
      "brokerPort": {
        "title": "Built-in broker port",
        "type": "integer",
        "default": 1883,
        "condition": {
          "functionBody": "return model.brokerMode !== 'external';"
        }
      },
      "host": {
        "title": "External broker host",
        "type": "string",
        "placeholder": "10.167.175.232",
        "condition": {
          "functionBody": "return model.brokerMode === 'external';"
        }
      },
      "port": {
        "title": "External broker port",
        "type": "integer",
        "default": 1883,
        "condition": {
          "functionBody": "return model.brokerMode === 'external';"
        }
      },
      "username": {
        "title": "MQTT username",
        "type": "string",
        "description": "Built-in broker: the login the Nuki lock (and Home Assistant, if used) must enter. Leave empty for no login."
      },
      "password": {
        "title": "MQTT password",
        "type": "string"
      },
      "deviceId": {
        "title": "Nuki device ID",
        "type": "string",
        "placeholder": "4E2CC127",
        "description": "Shown in the MQTT topics, e.g. nuki/4E2CC127/state. Optional with the built-in broker (any Nuki is accepted)."
      },
      "topicPrefix": {
        "title": "Topic prefix",
        "type": "string",
        "default": "nuki"
      },
      "resetMs": {
        "title": "Switch on-time (ms)",
        "type": "integer",
        "default": 1000,
        "minimum": 200
      },
      "logEvents": {
        "title": "Log every lock event",
        "type": "boolean",
        "default": true
      },
      "switches": {
        "title": "Switches",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Switch name",
              "type": "string",
              "required": true,
              "default": "Nuki Fingerprint"
            },
            "sources": {
              "title": "Triggered by",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "fingerprint",
                  "code"
                ]
              },
              "default": [
                "fingerprint"
              ]
            },
            "actions": {
              "title": "Lock actions",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "unlock",
                  "unlatch",
                  "locknGoUnlatch",
                  "lock",
                  "locknGo"
                ]
              },
              "default": [
                "unlock",
                "unlatch",
                "locknGoUnlatch"
              ]
            },
            "codeIds": {
              "title": "Only these Code IDs (optional, per person)",
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Leave empty for everyone. Code IDs appear in the Homebridge log."
            }
          }
        }
      }
    }
  }
}